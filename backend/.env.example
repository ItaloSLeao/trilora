# Gere uma senha alfanumérica exclusiva. Passe este arquivo ao Compose com --env-file.
POSTGRES_PASSWORD=
OLLAMA_HOST=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=qwen2.5:3b
# Opcional. Configure o par VAPID e um contato próprio para habilitar entrega externa.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
